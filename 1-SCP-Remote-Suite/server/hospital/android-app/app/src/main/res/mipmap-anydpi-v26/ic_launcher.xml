<?xml version="1.0" encoding="utf-8"?>
<!-- The web app's maskable icon, inset so its safe zone fits the launcher's mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_fg" android:inset="8%" />
    </foreground>
</adaptive-icon>
