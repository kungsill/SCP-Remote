<?xml version="1.0" encoding="utf-8"?>
<!-- Input field: soft grey fill, pink edge while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="1.5dp" android:color="@color/accent_light" />
            <corners android:radius="16dp" />
            <padding android:left="14dp" android:right="14dp" android:top="12dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg" />
            <stroke android:width="1dp" android:color="@color/card_border" />
            <corners android:radius="16dp" />
            <padding android:left="14dp" android:right="14dp" android:top="12dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
