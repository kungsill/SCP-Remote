<?xml version="1.0" encoding="utf-8"?>
<!-- Thin rounded progress bar: grey track, pink gradient fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/card_border" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape><gradient android:angle="0" android:startColor="@color/accent" android:endColor="@color/accent_light" /><corners android:radius="4dp" /></shape>
        </clip>
    </item>
</layer-list>
