<?xml version="1.0" encoding="utf-8"?>
<!--
  Computer list. The pink header (greeting, account, stats card) scrolls away; search and the
  department chips stay pinned. On Android 15+ the header keeps a strip under the status bar.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/headerBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="62dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F6DCEA"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/who"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/prompt"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/via"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/pill"
                        android:backgroundTint="#2EFFFFFF"
                        android:drawableStart="@drawable/ic_wifi"
                        android:drawablePadding="5dp"
                        android:drawableTint="@android:color/white"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:text="@string/via_internet"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Account initial; tap for refresh, update, sign out. -->
                <TextView
                    android:id="@+id/more"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/avatar_circle"
                    android:contentDescription="@string/menu"
                    android:fontFamily="@font/prompt"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stats card floating over the header's lower edge. -->
            <LinearLayout
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="-46dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/card_plain"
                android:elevation="8dp"
                android:orientation="horizontal"
                android:outlineSpotShadowColor="#55782858"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <LinearLayout style="@style/StatCell">
                    <TextView android:id="@+id/statTotal" style="@style/StatNumber" android:textColor="@color/text" />
                    <TextView style="@style/StatLabel" android:text="@string/stat_total" />
                </LinearLayout>

                <View style="@style/StatDivider" />

                <LinearLayout style="@style/StatCell">
                    <TextView android:id="@+id/statOnline" style="@style/StatNumber" android:textColor="@color/online" />
                    <TextView style="@style/StatLabel" android:text="@string/online" />
                </LinearLayout>

                <View style="@style/StatDivider" />

                <LinearLayout style="@style/StatCell">
                    <TextView android:id="@+id/statOffline" style="@style/StatNumber" android:textColor="@color/offline" />
                    <TextView style="@style/StatLabel" android:text="@string/offline" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Pinned: search, with ✕ to clear it, and the department chips. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <EditText
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/search_pill"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/text_muted"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/clearSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_search"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <!-- Departments: one tap filters. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
