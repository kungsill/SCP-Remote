<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <th.sichomphu.scpremote.ui.RemoteCanvas
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- The key bar (full control only) sits under the picture, above the phone keyboard. -->
        <FrameLayout
            android:id="@+id/keybarHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Connection state over the picture, with Retry when it has ended. -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/overlay"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@android:color/white" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retry"
            style="@style/Button.Accent"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>

        <!-- Floating menu button (drag it anywhere): keyboard, mouse mode, quality, display,
         Ctrl+Alt+Del, help, disconnect. The dot is the connection's signal light. -->
    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp">

        <ImageButton
            android:id="@+id/fabButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/fab_bg"
            android:contentDescription="@string/menu"
            android:elevation="6dp"
            android:src="@drawable/ic_menu" />

        <View
            android:id="@+id/signalDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:background="@drawable/signal_dot"
            android:elevation="7dp" />
    </FrameLayout>
</FrameLayout>