<?xml version="1.0" encoding="utf-8"?>
<!-- Confirm sheet for actions that cannot be undone (fix printing, restart, shut down). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:background="@drawable/sheet_handle" />

    <ImageView
        android:id="@+id/sheetIcon"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/tile_large"
        android:contentDescription="@null"
        android:padding="22dp" />

    <TextView
        android:id="@+id/sheetTitle"
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/sheetSubtitle"
        style="@style/Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/sheetWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/warn_box"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="@color/warn_fg"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sheetConfirm"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/button_outline"
            android:fontFamily="@font/prompt"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sheetCancel"
            style="@style/Button.Gradient"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
