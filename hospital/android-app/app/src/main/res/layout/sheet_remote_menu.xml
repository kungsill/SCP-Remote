<?xml version="1.0" encoding="utf-8"?>
<!-- Remote menu: computer + signal, a grid of coloured buttons, and Disconnect. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/menuTile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/tile"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_monitor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menuName"
                style="@style/Text.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/menuWhere"
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuSignal"
            style="@style/Text.Pill"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_wifi" />
    </LinearLayout>

    <TextView
        android:id="@+id/menuViewOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tile"
        android:backgroundTint="@color/tint_violet_bg"
        android:padding="10dp"
        android:text="@string/st_view_only"
        android:textColor="@color/tint_violet"
        android:textSize="13sp"
        android:visibility="gone" />

    <GridLayout
        android:id="@+id/menuGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:columnCount="4"
        android:useDefaultMargins="false" />

    <LinearLayout
        android:id="@+id/menuDisconnect"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_danger_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            android:tint="@color/danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/prompt"
            android:text="@string/disconnect"
            android:textColor="@color/danger"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
