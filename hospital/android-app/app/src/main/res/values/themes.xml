<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1.3.0: always light and clean (the phone's dark mode no longer turns the app dark).
         Sarabun for text, Prompt for headings; the hospital pink is the accent. -->
    <style name="Theme.ScpRemote" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_dark</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/card_border</item>
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/card</item>
        <item name="colorOutlineVariant">@color/card_border</item>
        <!-- No pink cast on raised surfaces (sheets, dialogs, menus): they stay pure white. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/accent_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <!-- Only android:fontFamily: AppCompat prefers app:fontFamily, which would beat a view's own
             android:fontFamily="@font/prompt" if the theme set it. -->
        <item name="android:fontFamily">@font/sarabun</item>
        <item name="materialButtonStyle">@style/Button.Accent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ScpRemote.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ScpRemote.Sheet</item>
        <item name="textAppearanceTitleLarge">@style/Text.Title</item>
        <item name="textAppearanceTitleMedium">@style/Text.TitleSmall</item>
        <item name="textAppearanceHeadlineSmall">@style/Text.Title</item>
    </style>

    <!-- Remote screen: dark, edge to edge (the desktop picture is the content). -->
    <style name="Theme.ScpRemote.Remote">
        <item name="android:windowBackground">@color/remote_bg</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Dialogs: white, well rounded, Prompt title. -->
    <style name="ThemeOverlay.ScpRemote.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Button.Dialog</item>
        <item name="android:fontFamily">@font/sarabun</item>
    </style>
    <style name="Shape.Dialog" parent="">
        <item name="cornerSize">26dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/prompt</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">@font/prompt</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bottom sheets: white, 30 dp top corners (the sheet also covers the navigation bar area). -->
    <style name="ThemeOverlay.ScpRemote.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Sheet.Modal</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/sarabun</item>
    </style>
    <style name="Sheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/card</item>
        <item name="shapeAppearance">@style/Shape.Sheet</item>
    </style>
    <style name="Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">30dp</item>
        <item name="cornerSizeTopRight">30dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/prompt</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Gradient action button (Sign in, Connect, Upload): plain Button with our gradient. -->
    <style name="Button.Gradient" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_gradient</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/prompt</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">6dp</item>
        <!-- Soft pink glow instead of a grey shadow (Android 9+). -->
        <item name="android:outlineProvider">background</item>
        <item name="android:outlineSpotShadowColor">@color/accent</item>
        <item name="android:outlineAmbientShadowColor">@color/accent</item>
        <item name="android:drawableTint">@android:color/white</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#F3C4DB</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/prompt</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Button.Plain" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/prompt</item>
    </style>

    <!-- White text buttons on the pink header. -->
    <style name="Button.Header" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
