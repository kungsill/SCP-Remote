{
  "name": "meshcentral",
  "version": "1.2.5",
  "keywords": [
    "Remote Device Management",
    "Remote Device Monitoring",
    "Remote Desktop",
    "Remote Terminal",
    "Remote File Access",
    "KVM",
    "2FA",
    "Two-Factor Authentication",
    "Intel Active Management Technology",
    "Intel AMT"
  ],
  "homepage": "https://meshcentral.com",
  "description": "Web based remote computer management server",
  "author": "Ylian Saint-Hilaire <ylianst@gmail.com>",
  "main": "meshcentral.js",
  "bin": {
    "meshcentral": "bin/meshcentral"
  },
  "license": "Apache-2.0",
  "files": [
    "*.js",
    "amt",
    "bin",
    "rdp",
    "views",
    "emails",
    "agents",
    "public",
    "translate",
    "readme.txt",
    "license.txt",
    "sample-config.json",
    "sample-config-advanced.json",
    "hospital",
    "scripts",
    "LICENSE"
  ],
  "dependencies": {
    "@seald-io/nedb": "4.1.2",
    "@zip.js/zip.js": "2.8.26",
    "archiver": "7.0.1",
    "cbor": "5.2.0",
    "compression": "1.8.1",
    "cookie-session": "2.1.1",
    "express": "4.22.2",
    "express-handlebars": "7.1.3",
    "express-ws": "5.0.2",
    "ipcheck": "0.1.0",
    "minimist": "1.2.8",
    "multiparty": "4.3.0",
    "node-forge": "1.4.0",
    "otplib": "13.4.1",
    "ua-client-hints-js": "0.1.2",
    "ua-parser-js": "1.0.40",
    "ws": "8.21.1",
    "yauzl": "2.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ylianst/MeshCentral.git"
  },
  "readme": "readme.md",
  "devDependencies": {
    "esprima": "4.0.1",
    "html-minifier-terser": "7.2.0",
    "jsdom": "22.1.0"
  },
  "scripts": {
    "build:hospital": "node scripts/build-hospital.js",
    "start:hospital": "node scripts/start-hospital.js",
    "test:hospital": "node --test hospital/tests/*.test.js",
    "check:hospital": "node scripts/check-hospital.js",
    "service:install": "node scripts/service-hospital.js install",
    "service:uninstall": "node scripts/service-hospital.js uninstall",
    "service:start": "node scripts/service-hospital.js start",
    "service:stop": "node scripts/service-hospital.js stop",
    "service:restart": "node scripts/service-hospital.js restart",
    "update:system": "node scripts/update-system.js",
    "check:config": "node scripts/check-config.js",
    "allow:subnet": "node scripts/allow-subnet.js",
    "tunnel:mode": "node scripts/tunnel-mode.js",
    "build:setup-exe": "node scripts/build-setup-exe.js",
    "backup:copy": "node scripts/copy-backups.js",
    "drill:restore": "node scripts/restore-drill.js"
  },
  "optionalDependencies": {
    "node-windows": "0.1.14",
    "loadavg-windows": "1.1.1"
  }
}
